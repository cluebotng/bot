{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "automerge": true,
  "automergeStrategy": "rebase",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)composer\\.json$/"
      ],
      "matchStrings": ["\"cluebotng/wikipedia\":\\s*\"(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "cluebotng/wikipedia",
      "depNameTemplate": "cluebotng/wikipedia"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["composer"],
      "matchPackageNames": ["cluebotng/wikipedia"],
      "enabled": false
    },
    {
      "description": "Group PHP updates",
      "matchManagers": ["composer"],
      "groupName": "PHP dependencies"
    },
    {
      "description": "Group CI updates",
      "matchManagers": ["github-actions"],
      "groupName": "CI dependencies"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true
  }
}
